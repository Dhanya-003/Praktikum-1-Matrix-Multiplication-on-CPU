import matplotlib.pyplot as plt
import numpy as np

# Matrix sizes
sizes = np.array([64, 128, 256, 1024])

# Performance results (GFLOP/s)
naive = np.array([5.43, 2.35, 3.09, 0.84])
reordered = np.array([8.80, 13.58, 16.35, 10.89])
tiled = np.array([9.12, 5.08, 7.38, 7.4])
parallel = np.array([0.56, 4.42, 15.22, 20.35])

plt.figure(figsize=(9,6))

plt.plot(sizes, naive, marker='o', linewidth=2, label="Naive (i-j-k)")
plt.plot(sizes, reordered, marker='s', linewidth=2, label="Reordered (i-k-j)")
plt.plot(sizes, tiled, marker='^', linewidth=2, label="Tiled")
plt.plot(sizes, parallel, marker='D', linewidth=2, label="Parallel")

plt.xscale("log", base=2)

plt.xlabel("Matrix Size (N)", fontsize=12)
plt.ylabel("Performance (GFLOP/s)", fontsize=12)

plt.title("Matrix Multiplication Performance on CPU", fontsize=14)

plt.grid(True, linestyle="--", alpha=0.6)

plt.legend()

plt.tight_layout()

plt.savefig("figures/performance1.png", dpi=300)

plt.show()